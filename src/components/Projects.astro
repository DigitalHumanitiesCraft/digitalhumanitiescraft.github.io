---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/content';
import { getContent } from '../i18n/content';
import thumbSzd from '../assets/projects/szd.jpg';
import thumbRuza from '../assets/projects/ruza.webp';
import thumbMhdbdb from '../assets/projects/mhdbdb.png';
import thumbM3gim from '../assets/projects/m3gim.jpg';
import thumbFemprompt from '../assets/projects/femprompt.jpg';
import thumbFortunoff from '../assets/projects/fortunoff.png';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t, projects } = getContent(lang);
const thumbs = { szd: thumbSzd, ruza: thumbRuza, mhdbdb: thumbMhdbdb, m3gim: thumbM3gim, femprompt: thumbFemprompt, fortunoff: thumbFortunoff };
---

<section id="projects" class="projects">
  <div class="wrap">
    <div class="head">
      <h2 class="section-heading">{t.projectsTitle}</h2>
    </div>
    <div class="grid">
      {
        projects.map((p) => (
          <a href={p.url} target="_blank" rel="noopener" class="media-card">
            <div class="banner">
              <Image src={thumbs[p.thumbKey]} alt="" width={760} class="thumb" />
              <div class="hex banner-hex" aria-hidden="true" />
            </div>
            <div class="body">
              <h3>{p.title}</h3>
              <p class="partner">{p.partner}</p>
              <p class="desc">{p.desc}</p>
            </div>
          </a>
        ))
      }
    </div>
    <div class="more">
      <a href="https://github.com/DigitalHumanitiesCraft" target="_blank" rel="noopener">{t.projectsMore} →</a>
    </div>
  </div>
</section>

<style>
  .projects {
    position: relative;
    padding-block: 96px;
  }

  .head {
    max-width: 640px;
    margin-bottom: 56px;
  }

  /* Flex statt Grid, damit eine unvollständige letzte Reihe mittig steht. */
  .grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
  }

  .grid > .media-card {
    flex: 0 1 calc((100% - 48px) / 3);
  }

  .media-card {
    background: #fff;
  }

  .banner-hex {
    position: absolute;
    right: 22px;
    bottom: -15px;
    width: 28px;
    height: 31px;
    background: var(--ink);
  }

  .body {
    padding: 24px 26px 26px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  h3 {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .partner {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--purple);
    margin: 0;
  }

  .desc {
    font-size: 14.5px;
    line-height: 1.55;
    color: rgba(30, 39, 73, 0.7);
    margin: 0;
  }

  .more {
    margin-top: 36px;
    text-align: center;
  }

  .more a {
    font-weight: 600;
    font-size: 15px;
    color: var(--purple);
    border-bottom: 2px solid rgba(138, 79, 163, 0.3);
    padding-bottom: 2px;
  }

  .more a:hover {
    border-color: var(--purple);
    color: var(--purple);
  }

  @media (max-width: 900px) {
    .grid > .media-card {
      flex-basis: 100%;
    }

    h2 {
      font-size: 32px;
    }
  }
</style>
